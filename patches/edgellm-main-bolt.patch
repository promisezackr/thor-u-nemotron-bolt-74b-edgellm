+    for key in ("language_model.backbone.embeddings.weight", "backbone.embeddings.weight",
+                "model.embed_tokens.weight", "language_model.model.embed_tokens.weight"):
+        if key in shard_map:
+            with safe_open(shard_map[key], "pt", device="cpu") as f:
+                table = f.get_tensor(key)
+            param = model.lilicorr_embed_table
+            if tuple(table.shape) != tuple(param.shape):
+                raise ValueError(f"LiLiCorr embedding table shape {tuple(table.shape)} != {tuple(param.shape)}")
+            param.data = table.to(param.dtype).to(device)
+            logging.getLogger(__name__).info("LiLiCorr head: embedding table from %s (%s)", key, base_model_dir)
+            return
+    raise ValueError("LiLiCorr head: base embedding table not found in " + base_model_dir)
