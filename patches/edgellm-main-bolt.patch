@@ -0,0 +1,292 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LiLiCorr draft (nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr) on the DFlash V1 runtime contract.
+
+The LiLiCorr drafter is a DFlash-style parallel block drafter:
+
+* 5 decoder layers in the DFlash2 shape (grouped dynamic conv around attention and MLP),
+* sliding-window attention (1024) with a learned per-head attention sink and q/k norms,
+* ``fc`` consumes the hidden states of **six** target layers,
+* an extra "LiLiCorr" correlation head that re-ranks the per-slot top-k candidates.
+
+This module runs the drafter without the correlation head (plain per-slot top-1 proposals), which is
+exactly the DFlash V1 runtime path: logits out, block_size from the checkpoint, any number of target
+layers. The correlation head is a later runtime stage.
+"""
+import os
+from typing import List, Tuple
+
+import torch
+import torch.nn as nn
+
+from ...config import ModelConfig
+from ..dflash.modeling_dflash_draft import (DFlashCachedDecoderLayer,
+                                            DFlashDraftModel)
+from ..dflash2.modeling_dflash2_draft import DFlash2DecoderLayer
+from ..dspark.modeling_dspark_draft import DSparkCachedAttention
+from ..ops import dflash2_grouped_dynamic_conv
+from .lilicorr_head import LiLiCorrHead
+
+
+class LiLiCorrDecoderLayer(DFlash2DecoderLayer):
+    """DFlash2 conv layer whose attention adds sliding window + learned sink.
+
+    LiLiCorr weights are ~10x larger than usual (std ~0.25), so the MLP/attention branch
+    outputs exceed FP16 range. The converter folds power-of-two scales into up/down/o_proj;
+    this layer runs the (linear) output conv on the scaled values and multiplies back in FP32.
+    """
+
+    def __init__(self, config: ModelConfig, layer_idx: int) -> None:
+        super().__init__(config, layer_idx)
+        self.self_attn = DSparkCachedAttention(config, layer_idx)
+        fold = getattr(config, "lilicorr_scale_fold", None) or {}
+        self.mlp_unfold = float(fold.get("mlp", 1.0))
+        self.attn_unfold = float(fold.get("attn", 1.0))
+
+    def _conv_out(self, conv, hidden, coefficients, residual, unfold):
+        """conv.finish without the fused residual: conv(fp16 scaled) -> fp32 * unfold + residual."""
+        out = dflash2_grouped_dynamic_conv(hidden, coefficients, conv.base_kernel[1], None,
+                                           block_size=conv.block_size, kernel_size=conv.kernel_size,
+                                           group_size=conv.group_size, fuse_residual=0)
+        return residual + out.to(torch.float32) * unfold
+
+    def forward_ragged(self, hidden_states, h_delta, past_key_value,
+                       rope_cos_sin, **metadata):
+        batch = metadata["query_lengths"].shape[0]
+        block = hidden_states.shape[0] // batch
+        hidden_size = self.self_attn.hidden_size
+        residual = hidden_states.to(torch.float32).reshape(batch, block, hidden_size)
+        attention_input = self.input_layernorm(residual).to(torch.float16)
+        attention_input, attention_post = self.attention_conv.prepare(attention_input)
+        attention, present_kv = self.self_attn.forward_ragged(
+            attention_input.reshape(-1, hidden_size), h_delta, past_key_value,
+            rope_cos_sin, **metadata)
+        hidden_states = self._conv_out(self.attention_conv,
+                                       attention.reshape(batch, block, hidden_size),
+                                       attention_post, residual, self.attn_unfold)
+        residual = hidden_states
+        mlp_input = self.post_attention_layernorm(residual).to(torch.float16)
+        mlp_input, mlp_post = self.mlp_conv.prepare(mlp_input)
+        feed_forward = self.mlp(mlp_input)
+        hidden_states = self._conv_out(self.mlp_conv, feed_forward, mlp_post, residual,
+                                       self.mlp_unfold)
+        return hidden_states.reshape(-1, hidden_size), present_kv
+
+
+class LiLiCorrPlainDecoderLayer(DFlashCachedDecoderLayer):
+    """Debug variant: no grouped conv, SWA/sink attention only."""
+
+    def __init__(self, config: ModelConfig, layer_idx: int) -> None:
+        super().__init__(config, layer_idx)
+        self.self_attn = DSparkCachedAttention(config, layer_idx)
+
+
+class LiLiCorrDraftModel(DFlashDraftModel):
+    """DFlash V1 contract (logits output) with LiLiCorr layers.
+
+    The residual stream runs in FP32 inside the DFlash2 layers; the final norm output is cast back to
+    FP16 before the (NVFP4 / FP16) lm_head.
+    """
+    # The exporter constant-folds the tiny fp32-cast head weights (e.g. feature_mlp.up_proj [5,1024]) into
+    # anonymous fp16 initializers; this opt-in restores them to FP32 when the MatMul's other input is FP32.
+    match_fp32_matmul_initializers = True
+
+    def post_export_onnx_fixup(self, onnx_path: str) -> None:
+        """Called by the exporter after its generic dtype fixup (see onnx_dtype_fixup.py)."""
+        from .onnx_dtype_fixup import fix_mixed_dtype_binary_ops
+        fix_mixed_dtype_binary_ops(onnx_path)
+
+    def __init__(self, config: ModelConfig) -> None:
+        super().__init__(config)
+        # Export-time numeric bisection: embed_only | fc_only | (unset = full model)
+        self.debug_mode = os.environ.get("LILICORR_DEBUG_MODE", "")
+        layer_cls = (LiLiCorrPlainDecoderLayer
+                     if getattr(config, "lilicorr_no_conv", False) else
+                     LiLiCorrDecoderLayer)
+        self.layers = nn.ModuleList([
+            layer_cls(config, layer_idx=i)
+            for i in range(config.num_hidden_layers)
+        ])
+        # Optional LiLiCorr correlation head (per-slot top-k re-ranking lattice). Weights live under
+        # ``lilicorr.*``; the token embedding table is copied from the base checkpoint at load time.
+        head_cfg = getattr(config, "lilicorr_head", None) or {}
+        self.lilicorr = None
+        if head_cfg:
+            # The head is specialised for the runtime proposal block (rows per sequence); the checkpoint
+            # block (8) only sizes the slot embedding / slot-distance bias tables.
+            head_block = int(os.environ.get("EDGELLM_LILICORR_BLOCK", config.dflash_block_size))
+            self.lilicorr = LiLiCorrHead(
+                config.hidden_size, int(head_cfg["lilicorr_hidden_size"]),
+                int(head_cfg["lilicorr_candidate_topk"]), int(head_cfg["lilicorr_num_heads"]),
+                int(head_cfg["lilicorr_num_layers"]), int(head_cfg["lilicorr_factor_dim"]),
+                head_block, float(head_cfg.get("lilicorr_mlp_ratio", 2.0)),
+                float(head_cfg.get("lilicorr_vector_eps", 1e-4)),
+                float(head_cfg.get("lilicorr_logit_scale", 8.0)), float(config.rms_norm_eps),
+                ckpt_block_size=int(config.dflash_block_size))
+            self.lilicorr_embed_table = nn.Parameter(
+                torch.zeros(config.vocab_size, config.hidden_size, dtype=torch.float16),
+                requires_grad=False)
+
+    def _h_delta(self, target_hidden_concat: torch.Tensor,
+                 dtype: torch.dtype) -> torch.Tensor:
+        if self.fc_native_precision:
+            h_delta_acc = self.fc(target_hidden_concat.to(torch.float16))
+        else:
+            bias = (self.fc.bias.to(torch.float32)
+                    if self.fc.bias is not None else None)
