+bool LLMRankRuntime::runChunkedPrefill(
+    DecodingInferenceContext& context, DecodingStrategy& strategy, bool initializeStrategy)
+{
+    ELLM_CHECK(context.activeBatchSize == 1, "Chunked prefill supports a single request only.");
+    std::vector<int32_t> const full = context.tokenIds[0];
+    int32_t const total = context.effectivePrefillLengths[0];
+    ELLM_CHECK(total > 0 && static_cast<size_t>(total) <= full.size(), "Chunked prefill: invalid prefill length.");
+    bool const hasDraft = strategy.isSpeculative();
+    int32_t chunk = mDeployment.base.maxSupportedInputLength;
+    if (hasDraft && mDeployment.draft.has_value())
+    {
+        chunk = std::min(chunk, mDeployment.draft->maxSupportedInputLength);
+    }
+    if (int32_t const override = prefillChunkOverride(); override > 0)
+    {
+        chunk = std::min(chunk, override);
+    }
+    ELLM_CHECK(chunk > 0, "Chunked prefill: invalid chunk size.");
+    LOG_INFO("Chunked prefill: %d tokens in chunks of %d.", total, chunk);
+    for (int32_t offset = 0; offset < total; offset += chunk)
+    {
+        int32_t const len = std::min(chunk, total - offset);
+        bool const last = offset + len >= total;
+        context.tokenIds[0].assign(full.begin() + offset, full.begin() + offset + len);
+        context.effectivePrefillLengths[0] = len;
+        if (!runBaseModelPrefill(context, /*managedKVCacheRequest=*/nullptr, /*sampleOutput=*/last))
+        {
+            LOG_ERROR("Chunked prefill: base prefill failed at offset %d (len %d).", offset, len);
+            return false;
+        }
+        if (hasDraft)
+        {
+            if (!last)
+            {
+                // Non-sampling chunk: sync before the draft repacks the shared pinned token buffer.
+                CUDA_CHECK(cudaStreamSynchronize(context.stream));
+            }
+            // DFlash round-0 draft prefill over this chunk's base hidden states (always, even without a managed KV
+            // request: the decode loop's round-0 draft pass would otherwise bind the whole prompt length against
+            // baseHiddenStates, which only holds the last chunk). The draft cache manager commits the chunk length so
+            // the next chunk appends at the right positions; the last chunk (after sampling) leaves the real pending
+            // proposal that round 0 consumes.
+            if (!strategy.initializeForGeneration(context))
+            {
+                LOG_ERROR("Chunked prefill: draft prefill failed at offset %d (len %d).", offset, len);
+                return false;
+            }
+        }
+        LOG_DEBUG("Chunked prefill: chunk [%d, %d) of %d done.", offset, offset + len, total);
+    }
+    // Restore full-prompt bookkeeping: the last chunk's sampling appended the first generated token.
+    int32_t const sampledToken = context.tokenIds[0].back();
+    context.tokenIds[0] = full;
+    context.tokenIds[0].push_back(sampledToken);
+    context.effectivePrefillLengths[0] = total;
+    if (!hasDraft && initializeStrategy && !strategy.initializeForGeneration(context))
+    {
+        LOG_ERROR("Chunked prefill: strategy initialization failed.");
+        return false;
+    }
+    return true;
+}
