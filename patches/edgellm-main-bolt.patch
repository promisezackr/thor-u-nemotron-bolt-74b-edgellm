+
+void DFlashDecoder::initLiLiCorrLattice(int32_t maxBatch)
+{
+    if (!mDraftExecutor)
+    {
+        return;
+    }
+    auto const& engine = mDraftExecutor->getEngine();
+    bool found = false;
+    for (int32_t i = 0; i < engine.getNbIOTensors(); ++i)
+    {
+        if (std::string(engine.getIOTensorName(i)) == "lilicorr_candidates")
+        {
+            found = true;
+        }
+    }
+    if (!found)
+    {
+        return;
+    }
+    nvinfer1::Dims const candDims = engine.getTensorShape("lilicorr_candidates");
+    mLiLiTopK = candDims.d[candDims.nbDims - 1];
+    int32_t const slots = mBlockDraft.blockSize - 1;
+    check::check(mLiLiTopK > 0 && slots > 0, "LiLiCorr lattice: invalid top-k or block size");
+    mLiLiCandidates = Tensor({maxBatch, slots, mLiLiTopK}, DeviceType::kGPU, nvinfer1::DataType::kINT32,
+        "DFlashDraft::lilicorrCandidates");
+    mLiLiScores = Tensor({maxBatch, slots, mLiLiTopK, mLiLiTopK}, DeviceType::kGPU, nvinfer1::DataType::kFLOAT,
+        "DFlashDraft::lilicorrScores");
+    mDraftTensorMap.set("lilicorr_candidates", mLiLiCandidates);
+    mDraftTensorMap.set("lilicorr_scores", mLiLiScores);
+    mHostLiLiCandidates.resize(static_cast<size_t>(maxBatch) * slots * mLiLiTopK);
+    mHostLiLiScores.resize(static_cast<size_t>(maxBatch) * slots * mLiLiTopK * mLiLiTopK);
+    mHostLiLiDraftIds.resize(static_cast<size_t>(maxBatch) * mBlockDraft.blockSize);
+    mHasLiLiCorr = true;
+    LOG_INFO("DFlashDecoder: LiLiCorr lattice enabled (top-k=%d, slots=%d)", mLiLiTopK, slots);
+}
+
+void DFlashDecoder::applyLiLiCorrLattice(int32_t activeBatchSize, cudaStream_t stream)
+{
+    int32_t const bs = mBlockDraft.blockSize;
+    int32_t const slots = bs - 1;
+    int32_t const k = mLiLiTopK;
+    size_t const nCand = static_cast<size_t>(activeBatchSize) * slots * k;
+    size_t const nScores = nCand * k;
+    size_t const nIds = static_cast<size_t>(activeBatchSize) * bs;
+    CUDA_CHECK(cudaMemcpyAsync(mHostLiLiCandidates.data(), mLiLiCandidates.rawPointer(), nCand * sizeof(int32_t),
+        cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(mHostLiLiScores.data(), mLiLiScores.rawPointer(), nScores * sizeof(float),
+        cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(mHostLiLiDraftIds.data(), mDraftTokenIds.rawPointer(), nIds * sizeof(int32_t),
+        cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    for (int32_t b = 0; b < activeBatchSize; ++b)
+    {
+        int32_t pred = 0;
+        for (int32_t s = 0; s < slots; ++s)
+        {
+            float const* row = mHostLiLiScores.data() + ((static_cast<size_t>(b) * slots + s) * k + pred) * k;
+            int32_t best = 0;
+            for (int32_t c = 1; c < k; ++c)
+            {
+                if (row[c] > row[best])
+                {
+                    best = c;
+                }
+            }
+            pred = best;
+            mHostLiLiDraftIds[static_cast<size_t>(b) * bs + 1 + s]
+                = mHostLiLiCandidates[(static_cast<size_t>(b) * slots + s) * k + pred];
+        }
+    }
+    CUDA_CHECK(cudaMemcpyAsync(mDraftTokenIds.rawPointer(), mHostLiLiDraftIds.data(), nIds * sizeof(int32_t),
+        cudaMemcpyHostToDevice, stream));
+}
