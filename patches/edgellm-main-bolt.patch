+
+using namespace trt_edgellm;
+using json = nlohmann::json;
+
+namespace
+{
+
+struct Args
+{
+    std::string engineDir;
+    std::string host{"0.0.0.0"};
+    int port{8081};
+    std::string modelName{"qwen3.8-27b"};
+    bool specDecode{false};
+    int32_t specDraftTopK{2};
+    int32_t specDraftStep{6};
+    int32_t specVerifySize{16};
+    int32_t dflashBlockSize{0};
+    int64_t defaultMaxTokens{1024};
+    int64_t maxTokensCap{4096};
+    int32_t streamInterval{1};
+    std::string toolFormat{"auto"}; // qwen | nemotron | auto (sniff chat_template.jinja for "<function=")
+    bool defaultThinking{false};
+};
+
+void printUsage(char const* argv0)
+{
+    std::cerr << "Usage: " << argv0
+              << " --engineDir DIR [--host 0.0.0.0] [--port 8081] [--model NAME] [--specDecode]"
+                 " [--specDraftTopK N] [--specDraftStep N] [--specVerifySize N] [--dflashBlockSize N]"
+                 " [--maxTokens N] [--maxTokensCap N] [--streamInterval N] [--defaultThinking] [--toolFormat qwen|nemotron|auto]\n";
+}
+
+bool parseArgs(int argc, char** argv, Args& a)
+{
+    for (int i = 1; i < argc; ++i)
+    {
+        std::string const k = argv[i];
+        auto next = [&](std::string& out) {
+            if (i + 1 >= argc)
+            {
+                return false;
+            }
+            out = argv[++i];
+            return true;
+        };
+        std::string v;
+        if (k == "--engineDir" && next(v))
+            a.engineDir = v;
+        else if (k == "--host" && next(v))
+            a.host = v;
+        else if (k == "--port" && next(v))
+            a.port = std::stoi(v);
+        else if (k == "--model" && next(v))
+            a.modelName = v;
+        else if (k == "--specDecode")
+            a.specDecode = true;
+        else if (k == "--specDraftTopK" && next(v))
+            a.specDraftTopK = std::stoi(v);
+        else if (k == "--specDraftStep" && next(v))
+            a.specDraftStep = std::stoi(v);
+        else if (k == "--specVerifySize" && next(v))
+            a.specVerifySize = std::stoi(v);
+        else if (k == "--dflashBlockSize" && next(v))
+            a.dflashBlockSize = std::stoi(v);
+        else if (k == "--maxTokens" && next(v))
+            a.defaultMaxTokens = std::stoll(v);
+        else if (k == "--maxTokensCap" && next(v))
+            a.maxTokensCap = std::stoll(v);
+        else if (k == "--streamInterval" && next(v))
+            a.streamInterval = std::stoi(v);
+        else if (k == "--toolFormat" && next(v))
+            a.toolFormat = v;
+        else if (k == "--defaultThinking")
+            a.defaultThinking = true;
+        else if (k == "-h" || k == "--help")
+        {
+            printUsage(argv[0]);
+            return false;
+        }
+        else
+        {
+            std::cerr << "Unknown or incomplete option: " << k << "\n";
+            printUsage(argv[0]);
+            return false;
+        }
+    }
+    if (a.engineDir.empty())
+    {
+        printUsage(argv[0]);
+        return false;
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------- tiny HTTP
+
+struct HttpRequest
+{
+    std::string method;
+    std::string path;
+    std::unordered_map<std::string, std::string> headers; // lower-case keys
+    std::string body;
+};
+
+bool sendAll(int fd, char const* data, size_t len)
+{
+    while (len > 0)
+    {
+        ssize_t const n = ::send(fd, data, len, MSG_NOSIGNAL);
+        if (n <= 0)
+        {
+            return false;
+        }
+        data += n;
+        len -= static_cast<size_t>(n);
+    }
+    return true;
+}
+
+bool sendAll(int fd, std::string const& s)
+{
+    return sendAll(fd, s.data(), s.size());
+}
+
+std::string toLower(std::string s)
+{
+    for (auto& c : s)
+    {
+        c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    }
+    return s;
+}
+
+bool readRequest(int fd, HttpRequest& req)
+{
+    std::string buf;
+    char tmp[8192];
+    size_t headerEnd = std::string::npos;
+    while (headerEnd == std::string::npos)
+    {
+        ssize_t const n = ::recv(fd, tmp, sizeof(tmp), 0);
+        if (n <= 0)
+        {
+            return false;
+        }
+        buf.append(tmp, static_cast<size_t>(n));
+        headerEnd = buf.find("\r\n\r\n");
+        if (buf.size() > (1u << 20))
+        {
+            return false;
+        }
+    }
+    std::string const head = buf.substr(0, headerEnd);
+    std::string rest = buf.substr(headerEnd + 4);
+    size_t pos = 0;
+    size_t lineEnd = head.find("\r\n");
+    std::string const reqLine = head.substr(0, lineEnd);
+    {
+        size_t const s1 = reqLine.find(' ');
+        size_t const s2 = reqLine.find(' ', s1 + 1);
+        if (s1 == std::string::npos || s2 == std::string::npos)
+        {
+            return false;
+        }
+        req.method = reqLine.substr(0, s1);
+        req.path = reqLine.substr(s1 + 1, s2 - s1 - 1);
+    }
+    pos = (lineEnd == std::string::npos) ? head.size() : lineEnd + 2;
+    while (pos < head.size())
+    {
+        size_t e = head.find("\r\n", pos);
+        if (e == std::string::npos)
+        {
+            e = head.size();
+        }
+        std::string const line = head.substr(pos, e - pos);
+        size_t const c = line.find(':');
+        if (c != std::string::npos)
+        {
+            std::string key = toLower(line.substr(0, c));
+            std::string val = line.substr(c + 1);
+            while (!val.empty() && (val.front() == ' ' || val.front() == '\t'))
+            {
+                val.erase(val.begin());
+            }
+            req.headers[key] = val;
+        }
+        pos = e + 2;
+    }
+    size_t contentLength = 0;
+    if (auto it = req.headers.find("content-length"); it != req.headers.end())
+    {
+        contentLength = static_cast<size_t>(std::stoull(it->second));
+    }
+    if (contentLength > (64u << 20))
+    {
+        return false;
+    }
+    while (rest.size() < contentLength)
+    {
+        ssize_t const n = ::recv(fd, tmp, sizeof(tmp), 0);
+        if (n <= 0)
+        {
+            return false;
+        }
+        rest.append(tmp, static_cast<size_t>(n));
+    }
+    req.body = rest.substr(0, contentLength);
+    return true;
+}
+
+void sendJson(int fd, int status, json const& body)
+{
+    std::string const payload = body.dump();
+    char const* reason = status == 200 ? "OK" : (status == 400 ? "Bad Request" : (status == 404 ? "Not Found" : "Error"));
+    std::string head = "HTTP/1.1 " + std::to_string(status) + " " + reason
+        + "\r\nContent-Type: application/json\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\nContent-Length: "
+        + std::to_string(payload.size()) + "\r\n\r\n";
+    sendAll(fd, head);
+    sendAll(fd, payload);
+}
+
+bool sendChunk(int fd, std::string const& data)
+{
+    char lenbuf[32];
+    std::snprintf(lenbuf, sizeof(lenbuf), "%zx\r\n", data.size());
+    return sendAll(fd, lenbuf) && sendAll(fd, data) && sendAll(fd, "\r\n");
+}
+
+// ------------------------------------------------------------- OpenAI glue
+
+std::string nowId()
+{
+    return "chatcmpl-" + std::to_string(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch())
+                                            .count());
+}
+
+std::string contentToText(json const& content)
+{
+    if (content.is_string())
+    {
+        return content.get<std::string>();
+    }
+    if (content.is_array())
+    {
+        std::string out;
+        for (auto const& part : content)
+        {
+            if (part.is_object() && part.value("type", "") == "text")
+            {
+                out += part.value("text", "");
+            }
+            else if (part.is_string())
+            {
+                out += part.get<std::string>();
+            }
+        }
+        return out;
+    }
+    if (content.is_null())
+    {
+        return "";
+    }
+    return content.dump();
+}
+
+// Qwen-native tool block, as the official chat template renders it.
+std::string renderToolsSystemBlock(json const& tools)
+{
+    std::string s = "# Tools\n\nYou may call one or more functions to assist with the user query.\n\n"
+                    "You are provided with function signatures within <tools></tools> XML tags:\n<tools>\n";
+    for (auto const& t : tools)
+    {
+        s += t.dump() + "\n";
+    }
+    s += "</tools>\n\nFor each function call, return a json object with function name and arguments within "
+         "<tool_call></tool_call> XML tags:\n<tool_call>\n{\"name\": <function-name>, \"arguments\": <args-json-object>}\n"
+         "</tool_call>";
+    return s;
+}
+
+// Tool-call wire format of the served model. Nemotron 3.5 (Bolt) renders tools as XML-ish <function>/<parameter>
+// blocks and expects calls as <tool_call>\n<function=NAME>\n<parameter=K>\nV\n</parameter>...</function>\n</tool_call>.
+bool gNemotronTools = false;
+
+std::string renderToolsSystemBlockNemotron(json const& tools)
+{
+    std::string s = "# Tools\n\nYou have access to the following functions:\n\n<tools>";
+    for (auto const& t0 : tools)
+    {
+        json const& t = t0.contains("function") ? t0["function"] : t0;
+        s += "\n<function>\n<name>" + t.value("name", std::string()) + "</name>";
+        if (t.contains("description"))
+        {
+            s += "\n<description>" + t.value("description", std::string()) + "</description>";
+        }
+        s += "\n<parameters>";
+        json const params = t.value("parameters", json::object());
+        if (params.is_object() && params.contains("properties") && params["properties"].is_object())
+        {
+            for (auto it = params["properties"].begin(); it != params["properties"].end(); ++it)
+            {
+                json const& f = it.value();
+                s += "\n<parameter>\n<name>" + it.key() + "</name>";
+                if (f.contains("type"))
+                {
+                    s += "\n<type>" + (f["type"].is_string() ? f["type"].get<std::string>() : f["type"].dump()) + "</type>";
+                }
+                if (f.contains("description") && f["description"].is_string())
+                {
+                    s += "\n<description>" + f["description"].get<std::string>() + "</description>";
+                }
+                if (f.contains("enum"))
+                {
+                    s += "\n<enum>" + f["enum"].dump() + "</enum>";
+                }
+                for (auto jt = f.begin(); jt != f.end(); ++jt)
+                {
+                    std::string const k = jt.key();
+                    if (k == "name" || k == "type" || k == "description" || k == "enum")
+                    {
+                        continue;
+                    }
+                    s += "\n<" + k + ">" + (jt.value().is_string() ? jt.value().get<std::string>() : jt.value().dump()) + "</" + k + ">";
+                }
+                s += "\n</parameter>";
+            }
+        }
+        if (params.is_object() && params.contains("required"))
+        {
+            s += "\n<required>" + params["required"].dump() + "</required>";
+        }
+        s += "\n</parameters>\n</function>";
+    }
+    s += "\n</tools>\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n"
+         "<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n"
+         "<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n"
+         "</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n"
+         "- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags\n"
+         "- Required parameters MUST be specified\n"
+         "- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after\n"
+         "- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n"
+         "</IMPORTANT>";
+    return s;
+}
+
+// Assistant-history rendering of one call in Nemotron format (mirrors the chat template).
+std::string renderNemotronCall(std::string const& name, json const& args)
+{
+    std::string s = "<tool_call>\n<function=" + name + ">\n";
+    if (args.is_object())
+    {
+        for (auto it = args.begin(); it != args.end(); ++it)
+        {
+            std::string v = (it.value().is_string()) ? it.value().get<std::string>() : it.value().dump();
+            s += "<parameter=" + it.key() + ">\n" + v + "\n</parameter>\n";
+        }
+    }
+    s += "</function>\n</tool_call>\n";
+    return s;
+}
+
+// Parses "<function=NAME>...<parameter=K>\nV\n</parameter>...</function>" into {name, arguments}; false if no function tag.
+bool parseNemotronCall(std::string const& inner, json& call)
+{
+    size_t const f = inner.find("<function=");
+    if (f == std::string::npos)
+    {
+        return false;
+    }
+    size_t const nameEnd = inner.find('>', f + 10);
+    if (nameEnd == std::string::npos)
+    {
+        return false;
+    }
+    std::string name = inner.substr(f + 10, nameEnd - f - 10);
+    while (!name.empty() && (name.back() == ' ' || name.back() == '\n')) name.pop_back();
+    json args = json::object();
+    size_t pos = nameEnd + 1;
+    while (true)
+    {
+        size_t const p = inner.find("<parameter=", pos);
+        if (p == std::string::npos) break;
+        size_t const pe = inner.find('>', p + 11);
+        if (pe == std::string::npos) break;
+        std::string key = inner.substr(p + 11, pe - p - 11);
+        size_t const ve = inner.find("</parameter>", pe + 1);
+        if (ve == std::string::npos) break;
+        std::string val = inner.substr(pe + 1, ve - pe - 1);
+        if (!val.empty() && val.front() == '\n') val.erase(0, 1);
+        if (!val.empty() && val.back() == '\n') val.pop_back();
+        json parsed;
+        bool typed = false;
+        if (!val.empty() && (val.front() == '{' || val.front() == '[' || val == "true" || val == "false" || val == "null"
+                                || ((std::isdigit(static_cast<unsigned char>(val.front())) || val.front() == '-') && val.find_first_not_of("-0123456789.eE") == std::string::npos)))
+        {
+            try { parsed = json::parse(val); typed = true; } catch (...) { typed = false; }
+        }
+        args[key] = typed ? parsed : json(val);
+        pos = ve + 12;
+    }
+    call["function"]["name"] = name;
+    call["function"]["arguments"] = args.dump();
+    return true;
+}
+
+rt::Message textMessage(std::string const& role, std::string const& text)
+{
+    rt::Message m;
+    m.role = role;
+    rt::Message::MessageContent c;
+    c.type = "text";
+    c.content = text;
+    m.contents.push_back(c);
+    return m;
+}
+
+// Converts OpenAI messages (+tools) into runtime messages.
+std::vector<rt::Message> buildMessages(json const& body)
+{
+    std::vector<rt::Message> out;
+    json const& msgs = body.at("messages");
+    std::string systemText;
+    bool haveSystem = false;
+    std::vector<rt::Message> rest;
+    for (auto const& m : msgs)
+    {
+        std::string const role = m.value("role", "user");
+        if (role == "system" || role == "developer")
+        {
+            if (haveSystem)
+            {
+                systemText += "\n\n";
+            }
+            systemText += contentToText(m.value("content", json()));
+            haveSystem = true;
+        }
+        else if (role == "tool")
+        {
+            // Qwen renders tool results inside a user turn as <tool_response> blocks.
+            std::string const text = "<tool_response>\n" + contentToText(m.value("content", json())) + "\n</tool_response>";
+            if (!rest.empty() && rest.back().role == "user" && rest.back().contents.size() == 1
+                && rest.back().contents[0].content.rfind("<tool_response>", 0) == 0)
+            {
+                rest.back().contents[0].content += "\n" + text;
+            }
+            else
+            {
+                rest.push_back(textMessage("user", text));
+            }
+        }
+        else if (role == "assistant")
+        {
+            std::string text = contentToText(m.value("content", json()));
+            if (m.contains("tool_calls") && m["tool_calls"].is_array())
+            {
+                for (auto const& tc : m["tool_calls"])
+                {
+                    json call;
+                    call["name"] = tc.value("function", json::object()).value("name", "");
+                    std::string args = tc.value("function", json::object()).value("arguments", "{}");
+                    try
+                    {
+                        call["arguments"] = json::parse(args);
+                    }
+                    catch (...)
+                    {
+                        call["arguments"] = args;
+                    }
+                    if (!text.empty() && text.back() != '\n')
+                    {
+                        text += "\n";
+                    }
+                    text += gNemotronTools ? renderNemotronCall(call["name"].get<std::string>(), call["arguments"])
+                                           : "<tool_call>\n" + call.dump() + "\n</tool_call>";
+                }
+            }
+            rest.push_back(textMessage("assistant", text));
+        }
+        else
+        {
+            rest.push_back(textMessage("user", contentToText(m.value("content", json()))));
+        }
+    }
+    if (body.contains("tools") && body["tools"].is_array() && !body["tools"].empty())
+    {
+        if (haveSystem)
+        {
+            systemText += "\n\n";
+        }
+        systemText += gNemotronTools ? renderToolsSystemBlockNemotron(body["tools"]) : renderToolsSystemBlock(body["tools"]);
+        haveSystem = true;
+    }
+    if (haveSystem)
+    {
+        out.push_back(textMessage("system", systemText));
+    }
+    out.insert(out.end(), rest.begin(), rest.end());
+    return out;
+}
+
+// Extracts <tool_call>...</tool_call> blocks; returns remaining text and the OpenAI tool_calls array.
+json extractToolCalls(std::string& text)
+{
+    json calls = json::array();
+    std::string const open = "<tool_call>";
+    std::string const close = "</tool_call>";
+    size_t pos = 0;
+    std::string cleaned;
+    while (true)
+    {
+        size_t const a = text.find(open, pos);
+        if (a == std::string::npos)
+        {
+            cleaned += text.substr(pos);
+            break;
+        }
+        cleaned += text.substr(pos, a - pos);
+        size_t const b = text.find(close, a + open.size());
+        if (b == std::string::npos)
+        {
+            cleaned += text.substr(a);
+            break;
+        }
+        std::string inner = text.substr(a + open.size(), b - a - open.size());
+        json call;
+        call["id"] = "call_" + std::to_string(calls.size() + 1);
+        call["type"] = "function";
+        if (parseNemotronCall(inner, call))
+        {
+            calls.push_back(call);
+        }
+        else
+        {
+            // JSON form ({"name":..,"arguments":{..}}); tolerate stray trailing braces/whitespace.
+            bool ok = false;
+            std::string candidate = inner;
+            for (int attempt = 0; attempt < 3 && !ok; ++attempt)
+            {
+                try
+                {
+                    json j = json::parse(candidate);
+                    call["function"]["name"] = j.value("name", "");
+                    json args = j.value("arguments", json::object());
+                    call["function"]["arguments"] = args.is_string() ? args.get<std::string>() : args.dump();
+                    calls.push_back(call);
+                    ok = true;
+                }
+                catch (...)
+                {
+                    size_t const last = candidate.find_last_of('}');
+                    if (last == std::string::npos || last == 0) break;
+                    candidate = candidate.substr(0, last); // drop one trailing brace and retry
+                    while (!candidate.empty() && std::isspace(static_cast<unsigned char>(candidate.back()))) candidate.pop_back();
+                }
+            }
+            if (!ok)
+            {
+                cleaned += text.substr(a, b + close.size() - a);
+            }
+        }
+        pos = b + close.size();
+    }
+    while (!cleaned.empty() && (cleaned.back() == '\n' || cleaned.back() == ' '))
+    {
+        cleaned.pop_back();
+    }
+    text = cleaned;
+    return calls;
+}
+
+std::string stripControlTokens(std::string text)
+{
+    for (char const* tok : {"<|im_end|>", "<|endoftext|>", "<|im_start|>"})
+    {
+        size_t p;
+        while ((p = text.find(tok)) != std::string::npos)
+        {
+            text.erase(p, std::strlen(tok));
+        }
+    }
+    return text;
+}
+
+// Splits a leading <think>...</think> block into reasoning; returns the remaining text.
+std::string splitReasoning(std::string const& text, std::string& reasoning)
+{
+    size_t const b = text.find("</think>");
+    if (b == std::string::npos)
+    {
+        return text;
+    }
+    // With thinking enabled the template opens <think> inside the prompt, so the output may carry only the
+    // closing tag: everything before </think> is reasoning.
+    size_t a = text.find("<think>");
+    size_t const start = (a == std::string::npos || a > b) ? 0 : a + 7;
+    a = (a == std::string::npos || a > b) ? 0 : a;
+    reasoning = text.substr(start, b - start);
+    while (!reasoning.empty() && (reasoning.front() == '\n' || reasoning.front() == ' '))
+    {
+        reasoning.erase(reasoning.begin());
+    }
+    std::string rest = text.substr(0, a) + text.substr(b + 8);
+    size_t i = 0;
+    while (i < rest.size() && (rest[i] == '\n' || rest[i] == ' '))
+    {
+        ++i;
+    }
+    return rest.substr(i);
+}
+
+char const* openaiFinish(rt::FinishReason r, bool hadToolCalls)
+{
+    if (hadToolCalls)
+    {
+        return "tool_calls";
+    }
+    switch (r)
+    {
+    case rt::FinishReason::kLength: return "length";
+    case rt::FinishReason::kCancelled: return "stop";
+    case rt::FinishReason::kError: return "error";
+    default: return "stop";
+    }
+}
+
+// ------------------------------------------------------------------ server
+
+struct Server
+{
+    Args args;
+    rt::LLMInferenceRuntime* runtime{nullptr};
+    cudaStream_t stream{};
+    std::mutex genMutex;
+    std::atomic<uint64_t> served{0};
+};
+
+void handleChat(Server& S, int fd, json const& body)
+{
+    bool const streaming = body.value("stream", false);
+    bool const toolsPresent = body.contains("tools") && body["tools"].is_array() && !body["tools"].empty();
+    bool toolMode = false;
+    std::string toolBuf;
+    rt::LLMGenerationRequest req;
+    rt::LLMGenerationRequest::Request r;
+    r.messages = buildMessages(body);
+    if (body.contains("stop"))
+    {
+        if (body["stop"].is_string())
+        {
+            r.stopStrings.push_back(body["stop"].get<std::string>());
+        }
+        else if (body["stop"].is_array())
+        {
+            for (auto const& s : body["stop"])
+            {
+                if (s.is_string())
+                {
+                    r.stopStrings.push_back(s.get<std::string>());
+                }
+            }
+        }
+    }
+    req.requests.push_back(std::move(r));
+    req.temperature = body.value("temperature", 0.0f);
+    req.topP = body.value("top_p", 0.8f);
+    req.topK = body.value("top_k", 20);
+    int64_t maxTokens = body.value("max_tokens", body.value("max_completion_tokens", S.args.defaultMaxTokens));
+    if (maxTokens <= 0)
+    {
+        maxTokens = S.args.defaultMaxTokens;
+    }
+    req.maxGenerateLength = std::min<int64_t>(maxTokens, S.args.maxTokensCap);
+    bool thinking = S.args.defaultThinking;
+    if (body.contains("chat_template_kwargs") && body["chat_template_kwargs"].is_object())
+    {
+        thinking = body["chat_template_kwargs"].value("enable_thinking", thinking);
+    }
+    thinking = body.value("enable_thinking", thinking);
+    req.enableThinking = thinking;
+
+    auto ch = rt::StreamChannel::create();
+    ch->setStreamInterval(S.args.streamInterval);
+    ch->setSkipSpecialTokens(false); // keep <tool_call>/<think>; chat-control tokens are stripped below
+    req.streamChannels.push_back(ch);
+
+    std::string const id = nowId();
+    long const created = static_cast<long>(std::time(nullptr));
+    std::string const model = body.value("model", S.args.modelName);
+
+    std::lock_guard<std::mutex> lock(S.genMutex);
+    auto const t0 = std::chrono::steady_clock::now();
+    rt::LLMGenerationResponse response;
+    std::atomic<bool> workerOk{false};
+    std::string workerError;
+    std::mutex workerErrorMutex;
+    std::thread worker([&] {
+        try
+        {
+            workerOk = S.runtime->handleRequest(req, response, S.stream);
+        }
+        catch (std::exception const& e)
+        {
+            std::lock_guard<std::mutex> g(workerErrorMutex);
+            workerError = e.what();
+            std::cerr << "handleRequest failed: " << workerError << "\n";
+            workerOk = false;
+        }
+        // A request rejected before generation (e.g. input too long) never finishes the channel:
+        // cancel it so the consumer loop below returns instead of blocking the server forever.
+        if (!ch->isFinished())
+        {
+            ch->cancel();
+        }
+    });
+
+    std::string fullText;
+    size_t tokensOut = 0;
+    int32_t promptTokens = -1;
+    rt::FinishReason reason = rt::FinishReason::kNotFinished;
+    bool clientGone = false;
+    bool headerSent = false;
+    double ttftMs = 0.0;
+
+    if (streaming)
+    {
+        std::string const head = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\n"
+                                 "Access-Control-Allow-Origin: *\r\nConnection: close\r\nTransfer-Encoding: chunked\r\n\r\n";
+        headerSent = sendAll(fd, head);
+        json first;
+        first["id"] = id;
+        first["object"] = "chat.completion.chunk";
+        first["created"] = created;
+        first["model"] = model;
+        first["choices"] = json::array({json{{"index", 0}, {"delta", json{{"role", "assistant"}, {"content", ""}}}, {"finish_reason", nullptr}}});
+        if (!sendChunk(fd, "data: " + first.dump() + "\n\n"))
+        {
+            clientGone = true;
+        }
+    }
+
+    // Streaming state for thinking mode: the template opens <think> in the prompt, so the output is
+    // reasoning until </think>; deltas before that go out as reasoning_content.
+    bool inReasoning = thinking;
+    std::string pending;
+    auto emitDelta = [&](json const& delta) {
+        json chunk;
+        chunk["id"] = id;
+        chunk["object"] = "chat.completion.chunk";
+        chunk["created"] = created;
+        chunk["model"] = model;
+        chunk["choices"] = json::array({json{{"index", 0}, {"delta", delta}, {"finish_reason", nullptr}}});
+        if (!sendChunk(fd, "data: " + chunk.dump() + "\n\n"))
+        {
+            clientGone = true;
+            ch->cancel();
+        }
+    };
+    auto streamText = [&](std::string const& text) {
+        pending += text;
+        while (!pending.empty())
+        {
+            if (inReasoning)
+            {
+                size_t const e = pending.find("</think>");
+                if (e != std::string::npos)
+                {
+                    std::string r = pending.substr(0, e);
+                    if (!r.empty())
+                    {
+                        emitDelta(json{{"reasoning_content", r}});
+                    }
+                    pending.erase(0, e + 8);
+                    while (!pending.empty() && (pending.front() == '\n' || pending.front() == ' '))
+                    {
+                        pending.erase(pending.begin());
+                    }
+                    inReasoning = false;
+                    continue;
+                }
+                // keep a possible partial "</think>" suffix for the next delta
+                size_t keep = 0;
+                for (size_t k = std::min<size_t>(7, pending.size()); k > 0; --k)
+                {
+                    if (std::string("</think>").compare(0, k, pending.substr(pending.size() - k)) == 0)
+                    {
+                        keep = k;
+                        break;
+                    }
+                }
+                std::string r = pending.substr(0, pending.size() - keep);
+                if (!r.empty())
+                {
+                    emitDelta(json{{"reasoning_content", r}});
+                }
+                pending.erase(0, pending.size() - keep);
+                return;
+            }
+            if (pending.rfind("<think>", 0) == 0)
+            {
+                pending.erase(0, 7);
+                inReasoning = true;
+                continue;
+            }
+            emitDelta(json{{"content", pending}});
+            pending.clear();
+        }
+    };
+
+    ch->consume([&](rt::StreamChunk&& c) {
+        if (ttftMs == 0.0 && !c.tokenIds.empty())
+        {
+            ttftMs = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        }
+        if (c.promptTokenCount >= 0)
+        {
+            promptTokens = c.promptTokenCount;
+        }
+        tokensOut += c.tokenIds.size();
+        fullText += c.text;
+        if (c.finished)
+        {
+            reason = c.reason;
+        }
+        std::string const deltaText = stripControlTokens(c.text);
+        if (streaming && !clientGone && !deltaText.empty())
+        {
+            if (!toolsPresent)
+            {
+                streamText(deltaText);
+            }
+            else if (!toolMode)
+            {
+                // Hold back tool-call markup: once "<tool_call>" appears everything after it is parsed at the end
+                // and returned as tool_calls, never as content.
+                toolBuf += deltaText;
+                size_t const tp = toolBuf.find("<tool_call>");
+                if (tp != std::string::npos)
+                {
+                    toolMode = true;
+                    if (tp > 0) streamText(toolBuf.substr(0, tp));
+                    toolBuf.clear();
+                }
+                else
+                {
+                    size_t keep = 0;
+                    for (size_t k = std::min<size_t>(10, toolBuf.size()); k > 0; --k)
+                    {
+                        if (std::string("<tool_call>").compare(0, k, toolBuf.substr(toolBuf.size() - k)) == 0) { keep = k; break; }
+                    }
+                    if (toolBuf.size() > keep) streamText(toolBuf.substr(0, toolBuf.size() - keep));
+                    toolBuf = toolBuf.substr(toolBuf.size() - keep);
+                }
+            }
+        }
+    });
+    worker.join();
+    if (streaming && !clientGone && toolsPresent && !toolMode && !toolBuf.empty())
+    {
+        streamText(toolBuf);
+        toolBuf.clear();
+    }
+    if (reason == rt::FinishReason::kNotFinished && ch->isFinished())
+    {
+        reason = ch->getReason();
+    }
+    double const totalMs = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    double const genMs = totalMs - ttftMs;
+    double const tps = (genMs > 0 && tokensOut > 1) ? (static_cast<double>(tokensOut - 1) / genMs * 1000.0) : 0.0;
+    ++S.served;
+    std::fprintf(stderr, "[req %llu] prompt_tokens=%d completion_tokens=%zu ttft=%.0fms total=%.0fms decode=%.1f tok/s finish=%s%s\n",
+        static_cast<unsigned long long>(S.served.load()), promptTokens, tokensOut, ttftMs, totalMs, tps,
+        rt::finishReasonName(reason), workerOk ? "" : " (worker error)");
+
+    if (!workerOk && tokensOut == 0)
+    {
+        std::string err;
+        {
+            std::lock_guard<std::mutex> g(workerErrorMutex);
+            err = workerError.empty() ? "generation failed" : workerError;
+        }
+        json e = json{{"error", json{{"message", err}, {"type", "invalid_request_error"}, {"code", "generation_failed"}}}};
+        if (streaming)
+        {
+            if (!clientGone)
+            {
+                sendChunk(fd, "data: " + e.dump() + "\n\n");
+                sendChunk(fd, "data: [DONE]\n\n");
+                sendAll(fd, "0\r\n\r\n");
+            }
+        }
+        else
+        {
+            sendJson(fd, 400, e);
+        }
+        return;
+    }
+
+    json usage;
+    usage["prompt_tokens"] = promptTokens < 0 ? 0 : promptTokens;
+    usage["completion_tokens"] = tokensOut;
+    usage["total_tokens"] = (promptTokens < 0 ? 0 : promptTokens) + static_cast<long>(tokensOut);
+
+    std::string reasoning;
+    std::string text = splitReasoning(stripControlTokens(fullText), reasoning);
+    json toolCalls = extractToolCalls(text);
+    bool const hadTools = !toolCalls.empty();
+
+    if (streaming)
+    {
+        if (!clientGone && !pending.empty())
+        {
+            emitDelta(json{{inReasoning ? "reasoning_content" : "content", pending}});
+            pending.clear();
+        }
+        if (!clientGone)
+        {
+            json last;
+            last["id"] = id;
+            last["object"] = "chat.completion.chunk";
+            last["created"] = created;
+            last["model"] = model;
+            json delta = json::object();
+            if (hadTools)
+            {
+                json tcs = json::array();
+                for (size_t i = 0; i < toolCalls.size(); ++i)
+                {
+                    json tc = toolCalls[i];
+                    tc["index"] = i;
+                    tcs.push_back(tc);
+                }
+                delta["tool_calls"] = tcs;
+            }
+            last["choices"] = json::array({json{{"index", 0}, {"delta", delta}, {"finish_reason", openaiFinish(reason, hadTools)}}});
+            last["usage"] = usage;
+            sendChunk(fd, "data: " + last.dump() + "\n\n");
+            sendChunk(fd, "data: [DONE]\n\n");
+            sendAll(fd, "0\r\n\r\n");
+        }
+        return;
+    }
+    (void) headerSent;
+    json out;
+    out["id"] = id;
+    out["object"] = "chat.completion";
+    out["created"] = created;
+    out["model"] = model;
+    json message;
+    message["role"] = "assistant";
+    message["content"] = hadTools && text.empty() ? json(nullptr) : json(text);
+    if (!reasoning.empty())
+    {
+        message["reasoning_content"] = reasoning;
+    }
+    if (hadTools)
+    {
+        message["tool_calls"] = toolCalls;
+    }
+    out["choices"] = json::array({json{{"index", 0}, {"message", message}, {"finish_reason", openaiFinish(reason, hadTools)}}});
+    out["usage"] = usage;
+    sendJson(fd, workerOk ? 200 : 500, out);
+}
+
+void handleConnection(Server& S, int fd)
+{
+    int one = 1;
+    ::setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    HttpRequest req;
+    if (!readRequest(fd, req))
+    {
+        ::close(fd);
+        return;
+    }
+    try
+    {
+        if (req.method == "OPTIONS")
+        {
+            std::string const head = "HTTP/1.1 204 No Content\r\nAccess-Control-Allow-Origin: *\r\n"
+                                     "Access-Control-Allow-Headers: *\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
+                                     "Connection: close\r\nContent-Length: 0\r\n\r\n";
+            sendAll(fd, head);
+        }
+        else if (req.method == "GET" && (req.path == "/health" || req.path == "/"))
+        {
+            sendJson(fd, 200, json{{"status", "ok"}, {"model", S.args.modelName}, {"served", S.served.load()}});
+        }
+        else if (req.method == "GET" && (req.path == "/v1/models" || req.path == "/models"))
+        {
+            json m;
+            m["object"] = "list";
+            m["data"] = json::array({json{{"id", S.args.modelName}, {"object", "model"}, {"owned_by", "thor"}}});
+            sendJson(fd, 200, m);
+        }
+        else if (req.method == "POST" && (req.path == "/v1/chat/completions" || req.path == "/chat/completions"))
+        {
+            json body = json::parse(req.body);
+            if (!body.contains("messages") || !body["messages"].is_array() || body["messages"].empty())
+            {
+                sendJson(fd, 400, json{{"error", json{{"message", "messages[] is required"}, {"type", "invalid_request_error"}}}});
+            }
+            else
+            {
+                handleChat(S, fd, body);
+            }
+        }
+        else
+        {
+            sendJson(fd, 404, json{{"error", json{{"message", "not found: " + req.method + " " + req.path}}}});
+        }
+    }
+    catch (std::exception const& e)
+    {
+        sendJson(fd, 400, json{{"error", json{{"message", e.what()}, {"type", "invalid_request_error"}}}});
+    }
+    ::shutdown(fd, SHUT_WR);
+    ::close(fd);
+}
+
+} // namespace
+
+int main(int argc, char** argv)
+{
+    Args args;
+    if (!parseArgs(argc, argv, args))
+    {
+        return 1;
+    }
+    std::signal(SIGPIPE, SIG_IGN);
+
+    // TensorRT plugin library (EDGELLM_PLUGIN_PATH); handles must outlive the runtime.
+    auto pluginHandles = loadEdgellmPluginLib();
+
+    cudaStream_t stream;
+    CUDA_CHECK(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+    std::unordered_map<std::string, std::string> loraMap;
+    std::unique_ptr<rt::LLMInferenceRuntime> runtime;
+    try
+    {
+        if (args.specDecode)
+        {
+            rt::SpecDecodeDraftingConfig draft{};
+            draft.draftingTopK = args.specDraftTopK;
+            draft.draftingStep = args.specDraftStep;
+            draft.verifySize = args.specVerifySize;
+            draft.dflashBlockSize = args.dflashBlockSize;
+            runtime = std::make_unique<rt::LLMInferenceRuntime>(args.engineDir, "", loraMap, draft, stream);
+        }
+        else
+        {
+            runtime = std::make_unique<rt::LLMInferenceRuntime>(args.engineDir, "", loraMap, stream);
+        }
+    }
+    catch (std::exception const& e)
+    {
+        std::cerr << "Runtime init failed: " << e.what() << "\n";
+        return 3;
+    }
+    {
+        std::string fmt = args.toolFormat;
+        if (fmt == "auto")
+        {
+            std::ifstream tf(args.engineDir + "/chat_template.jinja");
+            std::string tpl((std::istreambuf_iterator<char>(tf)), std::istreambuf_iterator<char>());
+            fmt = tpl.find("<function=") != std::string::npos ? "nemotron" : "qwen";
+        }
+        gNemotronTools = (fmt == "nemotron");
+        std::fprintf(stderr, "tool-call format: %s\n", fmt.c_str());
+    }
+    runtime->captureDecodingCUDAGraph(stream);
+
+    Server S;
+    S.args = args;
+    S.runtime = runtime.get();
+    S.stream = stream;
+
+    int const listenFd = ::socket(AF_INET, SOCK_STREAM, 0);
+    if (listenFd < 0)
+    {
+        std::perror("socket");
+        return 2;
+    }
+    int one = 1;
+    ::setsockopt(listenFd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(static_cast<uint16_t>(args.port));
+    if (::inet_pton(AF_INET, args.host.c_str(), &addr.sin_addr) != 1)
+    {
+        std::cerr << "bad --host\n";
+        return 2;
+    }
+    if (::bind(listenFd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0 || ::listen(listenFd, 16) != 0)
+    {
+        std::perror("bind/listen");
+        return 2;
+    }
+    std::fprintf(stderr, "llm_server ready: http://%s:%d/v1  engine=%s spec=%s(topK %d, step %d, verify %d) maxTokens=%lld\n",
+        args.host.c_str(), args.port, args.engineDir.c_str(), args.specDecode ? "on" : "off", args.specDraftTopK,
+        args.specDraftStep, args.specVerifySize, static_cast<long long>(args.defaultMaxTokens));
+
+    while (true)
+    {
+        sockaddr_in peer{};
+        socklen_t plen = sizeof(peer);
+        int const fd = ::accept(listenFd, reinterpret_cast<sockaddr*>(&peer), &plen);
+        if (fd < 0)
+        {
+            continue;
+        }
+        std::thread(handleConnection, std::ref(S), fd).detach();
+    }
+}
