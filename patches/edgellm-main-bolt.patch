+    def _logits_and_hidden(self, hidden_states: torch.Tensor):
+        normed = self.norm(hidden_states.to(torch.float32)).to(torch.float16)
+        logits = self.lm_head(normed).to(torch.float32)
+        cap = getattr(self.config, "final_logit_softcapping", None)
+        if cap is not None:
+            logits = torch.tanh(logits / cap) * cap
+        return logits, normed
+
+    def _head_outputs(self, logits, normed, h_delta, metadata):
+        """LiLiCorr lattice: candidates [B, slots, k] int32, scores [B, slots, k, k] fp32."""
+        # Static block (checkpoint block_size): the proposal always has exactly `block` rows per sequence,
+        # so batch follows from the row count without touching the (independently profiled) query_lengths.
+        block = int(self.lilicorr.block)  # runtime proposal block the head was exported for
+        rows = logits.shape[0]
+        batch = rows // block
+        # Split rows into [batch, block] with a gather instead of a reshape: torch.export cannot prove the
+        # symbolic row count divisible by a non-power-of-two block, but index_select needs no such proof.
+        row_sel = ((torch.arange(batch, device=logits.device, dtype=torch.int32) * block)[:, None]
+                   + torch.arange(block, device=logits.device, dtype=torch.int32)[None, :]).reshape(-1)
+        logits_b = logits.index_select(0, row_sel).reshape(batch, block, -1)
+        normed_b = normed.index_select(0, row_sel).reshape(batch, block, -1)
+        tok2seq = metadata["delta_token_to_sequence"].to(torch.int32)
+        seq_ids = torch.arange(batch, device=tok2seq.device, dtype=torch.int32)
+        # Last delta row of each sequence = max row index carrying that sequence id (no CumSum: TensorRT's
+        # CumSum lowering trips the Myelin optimizer with an empty-tensor plugin producer).
+        row_ids = torch.arange(h_delta.shape[0], device=tok2seq.device, dtype=torch.int32)
+        member = (tok2seq[None, :] == seq_ids[:, None]).to(torch.int32)  # [batch, delta_rows]
+        last_idx = (member * row_ids[None, :]).max(dim=1).values
+        anchor_g = h_delta.index_select(0, last_idx)  # fused target hidden of each sequence's anchor token
+        return self.lilicorr(logits_b, normed_b, anchor_g, self.lilicorr_embed_table)
+
+    def forward(
