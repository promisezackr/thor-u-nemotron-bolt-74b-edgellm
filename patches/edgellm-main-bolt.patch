+                rope_rotary_cos_sin, kvcache_start_index, kv_page_table,
+                delta_lengths, context_lengths, attention_mask,
+                attention_pos_id)
+            present_key_values.append(present_kv)
+        return self._logits(hidden_states), present_key_values
+
+    def forward_ragged(self, inputs_embeds: torch.Tensor,
+                       target_hidden_concat: torch.Tensor,
+                       past_key_values: Tuple[torch.Tensor, ...], **metadata):
+        if self.debug_mode == "embed_only":
+            probe = target_hidden_concat[:1, :inputs_embeds.shape[-1]].to(torch.float32) * 0.0
+            hidden = inputs_embeds.to(torch.float32) + probe
+            return self._logits(hidden), tuple(past_key_values)
+        if self.debug_mode == "fc_only":
+            h_delta = self._h_delta(target_hidden_concat, inputs_embeds.dtype)
+            hidden = inputs_embeds.to(torch.float32) + h_delta.to(torch.float32).mean(0, keepdim=True)
+            return self._logits(hidden), tuple(past_key_values)
+        h_delta = self._h_delta(target_hidden_concat, inputs_embeds.dtype)
+        if self.debug_mode in ("attn_only", "mlp_only"):
+            hidden = inputs_embeds.to(h_delta.dtype)
+            present = []
+            for layer_idx, layer in enumerate(self.layers):
+                if self.debug_mode == "attn_only":
+                    attn, present_kv = layer.self_attn.forward_ragged(
+                        layer.input_layernorm(hidden), h_delta,
+                        past_key_values[layer_idx],
+                        metadata["rope_rotary_cos_sin"], **metadata)
+                    hidden = hidden + attn
+                else:
+                    present_kv = past_key_values[layer_idx]
+                    hidden = hidden + layer.mlp(layer.post_attention_layernorm(hidden))
+                present.append(present_kv)
+            return self._logits(hidden), tuple(present)
+        hidden_states = (inputs_embeds.to(h_delta.dtype) if getattr(
+            self.config, "lilicorr_no_conv", False) else
+                         inputs_embeds.to(torch.float32))
+        present = []
+        for layer_idx, layer in enumerate(self.layers):
+            hidden_states, present_kv = layer.forward_ragged(
+                hidden_states, h_delta, past_key_values[layer_idx],
+                metadata["rope_rotary_cos_sin"], **metadata)
+            present.append(present_kv)
+        logits, normed = self._logits_and_hidden(hidden_states)
+        if self.lilicorr is not None:
+            cand, scores = self._head_outputs(logits, normed, h_delta, metadata)
+            return logits, tuple(present), (cand, scores)
+        return logits, tuple(present)
+
+    def onnx_export_spec(self):
+        spec = super().onnx_export_spec()
+        if self.lilicorr is None:
+            return spec
+        from ..default.modeling_default import OnnxSpec
+        return OnnxSpec(_make_lilicorr_wrapper(self, self.config.num_hidden_layers), spec.args,
+                        spec.input_names, list(spec.output_names) + ["lilicorr_candidates", "lilicorr_scores"],
+                        spec.dynamic_shapes)
+
+
+def _make_lilicorr_wrapper(model: nn.Module, num_layers: int) -> nn.Module:
+    """DFlash ragged wrapper that also returns the LiLiCorr lattice outputs."""
+    names = (["inputs_embeds", "dflash_target_hidden_concat"] +
+             [f"past_key_values_{i}" for i in range(num_layers)] + [
+                 "rope_rotary_cos_sin", "positions", "query_start_offsets",
+                 "query_lengths", "past_lengths", "attention_sequence_lengths",
+                 "state_indices", "execution_phase_marker",
+                 "context_sequence_count_carrier", "kv_page_table",
+                 "dflash_delta_rope_cos_sin", "dflash_delta_positions",
+                 "dflash_delta_token_to_sequence", "attention_position_ids",
+                 "packed_attention_mask"
+             ])
+    past_kv = "({},)".format(", ".join(f"past_key_values_{i}" for i in range(num_layers)))
+    body = (
+        f"    logits, present, extras = self._model.forward_ragged(\n"
+        f"        inputs_embeds, dflash_target_hidden_concat, {past_kv},\n"
+        f"        rope_rotary_cos_sin=rope_rotary_cos_sin, positions=positions,\n"
+        f"        query_start_offsets=query_start_offsets, query_lengths=query_lengths,\n"
+        f"        past_lengths=past_lengths,\n"
+        f"        attention_sequence_lengths=attention_sequence_lengths,\n"
+        f"        state_indices=state_indices, execution_phase_marker=execution_phase_marker,\n"
+        f"        context_sequence_count_carrier=context_sequence_count_carrier,\n"
+        f"        kv_page_table=kv_page_table, delta_rope_cos_sin=dflash_delta_rope_cos_sin,\n"
+        f"        delta_positions=dflash_delta_positions,\n"
+        f"        delta_token_to_sequence=dflash_delta_token_to_sequence,\n"
+        f"        attention_position_ids=attention_position_ids,\n"
+        f"        packed_attention_mask=packed_attention_mask)\n"
+        f"    return (logits,) + tuple(present) + tuple(extras)\n")
+    globs: dict = {}
+    exec("def _forward(self, {}):\n{}".format(", ".join(names), body), globs)  # noqa: S102
+
+    class _Wrapper(nn.Module):
+
+        def __init__(self, wrapped_model: nn.Module) -> None:
+            super().__init__()
+            self._model = wrapped_model
+
+    _Wrapper.forward = globs["_forward"]
+    return _Wrapper(model)
diff --git a/tensorrt_edgellm/models/lilicorr/onnx_dtype_fixup.py b/tensorrt_edgellm/models/lilicorr/onnx_dtype_fixup.py
new file mode 100644
index 0000000..48d4fbb
--- /dev/null
+++ b/tensorrt_edgellm/models/lilicorr/onnx_dtype_fixup.py
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Post-export pass: make every binary op in the exported draft graph dtype-consistent.
+
+The dynamo exporter constant-folds the LiLiCorr head's ``param.to(float32)`` casts into fp32 initializers
+and the generic Edge-LLM fixup then downcasts those to fp16.  The generic fixup only restores an
+initializer that is a *direct* input of the mismatched op; here the folded constant may reach the op
+through Unsqueeze/Reshape/... (e.g. the slot+rank position embedding).  This pass resolves such chains
+back to the initializer and promotes it to fp32; when the fp16 side is a real activation it inserts a
+Cast instead.  The head computes in fp32, so widening is always numerically safe.
+"""
+import logging
+import os
+
+import numpy as np
+import onnx
+from onnx import numpy_helper
+
+logger = logging.getLogger(__name__)
+
+_BINARY = frozenset({"Add", "Sub", "Mul", "Div", "MatMul", "Gemm", "Concat", "Pow", "Max", "Min", "Where"})
+_PASS_THROUGH = frozenset({"Unsqueeze", "Squeeze", "Reshape", "Transpose", "Expand", "Identity", "Flatten"})
+FP32, FP16 = onnx.TensorProto.FLOAT, onnx.TensorProto.FLOAT16
+
+
+def fix_mixed_dtype_binary_ops(onnx_path: str) -> int:
+    model = onnx.load(onnx_path)  # full load: initializers are re-saved below
+    g = model.graph
+    init = {t.name: t for t in g.initializer}
+    vi = {v.name: v for v in list(g.value_info) + list(g.input) + list(g.output)}
+    prod = {o: n for n in g.node for o in n.output}
+
+    def resolve_init(name, chain):
+        """Follow single-data-input shape ops back to an initializer; returns initializer name or None."""
+        while True:
+            if name in init:
+                return name
+            n = prod.get(name)
+            if n is None or n.op_type not in _PASS_THROUGH:
+                return None
+            chain.append(n)
+            name = n.input[0]
+
+    def dtype_of(name):
+        # value_info is stale for tensors derived from initializers the generic fixup downcast:
+        # resolve shape-op chains back to the initializer first.
+        src = resolve_init(name, [])
+        if src is not None:
+            return init[src].data_type
+        v = vi.get(name)
+        return v.type.tensor_type.elem_type if v is not None and v.type.tensor_type.HasField("elem_type") else 0
+
+    n_promoted = n_cast = 0
+    changed = True
+    rounds = 0
+    while changed and rounds < 6:
+        changed = False
+        rounds += 1
+        for node in list(g.node):
+            if node.op_type not in _BINARY or len(node.input) < 2:
+                continue
+            first_data = 1 if node.op_type == "Where" else 0  # Where[0] is the bool condition
+            dts = {dtype_of(i) for i in node.input[first_data:]}
+            if not (FP32 in dts and FP16 in dts):
+                continue
+            for idx, name in enumerate(node.input):
+                if idx < first_data or dtype_of(name) != FP16:
+                    continue
+                chain = []
+                src = resolve_init(name, chain)
+                if src is not None:
+                    t = init[src]
+                    data = numpy_helper.to_array(t).astype(np.float32)
+                    t.CopyFrom(numpy_helper.from_array(data, name=src))
+                    for inter in chain:  # refresh stale value_info along the chain
+                        if inter.output[0] in vi:
+                            vi[inter.output[0]].type.tensor_type.elem_type = FP32
+                    if src in vi:
+                        vi[src].type.tensor_type.elem_type = FP32
+                    n_promoted += 1
+                    logger.info("lilicorr dtype fixup: promoted initializer %s %s to FP32 (feeds %s %s)", src,
+                                list(t.dims), node.op_type, node.output[0])
+                else:
+                    new_name = f"{name}_f32_{n_cast}"
+                    cast = onnx.helper.make_node("Cast", [name], [new_name], to=FP32,
+                                                 name=f"lilicorr_cast_{n_cast}")
+                    pos = list(g.node).index(node)
+                    g.node.insert(pos, cast)
+                    node.input[idx] = new_name
+                    v = g.value_info.add()
+                    v.name = new_name
+                    v.type.tensor_type.elem_type = FP32
+                    vi[new_name] = v
+                    prod[new_name] = cast
+                    n_cast += 1
+                    logger.info("lilicorr dtype fixup: cast %s to FP32 before %s %s", name, node.op_type,
+                                node.output[0])
+                changed = True
+    total = n_promoted + n_cast
+    if total == 0:
+        return 0
+    data_file = os.path.basename(onnx_path) + ".data"
+    ext_path = os.path.join(os.path.dirname(onnx_path), data_file)
+    if os.path.isfile(ext_path):
+        os.remove(ext_path)
+    onnx.save_model(model, onnx_path, save_as_external_data=True, all_tensors_to_one_file=True,
+                    location=data_file, convert_attribute=True)
+    logger.info("lilicorr dtype fixup: %d initializers promoted, %d casts inserted (%d rounds)", n_promoted,
+                n_cast, rounds)
+    return total
