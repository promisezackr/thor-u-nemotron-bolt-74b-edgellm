+namespace
+{
+template <typename T>
+void dflashDebugStats(char const* label, Tensor const& t, int64_t rows, int64_t cols, cudaStream_t stream)
+{
+    std::vector<T> host(static_cast<size_t>(rows) * cols);
+    cudaStreamSynchronize(stream);
+    cudaMemcpy(host.data(), t.rawPointer(), host.size() * sizeof(T), cudaMemcpyDeviceToHost);
+    for (int64_t r = 0; r < rows; ++r)
+    {
+        double sumAbs = 0.0, maxAbs = 0.0;
+        int64_t nans = 0, infs = 0, argmax = 0;
+        float best = -std::numeric_limits<float>::infinity();
+        for (int64_t c = 0; c < cols; ++c)
+        {
+            float const v = static_cast<float>(host[r * cols + c]);
+            if (std::isnan(v)) { ++nans; continue; }
+            if (std::isinf(v)) { ++infs; continue; }
+            float const a = std::fabs(v);
+            sumAbs += a;
+            if (a > maxAbs) maxAbs = a;
+            if (v > best) { best = v; argmax = c; }
+        }
+        LOG_INFO("[dflash-debug] %s row %ld: cols=%ld nan=%ld inf=%ld meanAbs=%.4g maxAbs=%.4g argmax=%ld (%.4g)",
+            label, static_cast<long>(r), static_cast<long>(cols), static_cast<long>(nans), static_cast<long>(infs),
+            sumAbs / static_cast<double>(cols), maxAbs, static_cast<long>(argmax), best);
+    }
+}
