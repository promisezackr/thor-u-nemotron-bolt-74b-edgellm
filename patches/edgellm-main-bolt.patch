+void DFlashDecoder::debugDumpDraftStats(cudaStream_t stream)
+{
+    int64_t const bs = mBlockDraft.blockSize;
+    dflashDebugStats<half>("inputsEmbeds", mDraftInputsEmbeds, bs, mBlockDraft.draftHiddenSize, stream);
+    dflashDebugStats<half>("targetHidden", mDraftTargetHidden, std::min<int64_t>(bs, 2), mBlockDraft.baseOutputHiddenDim, stream);
+    dflashDebugStats<half>("baseHiddenStates", mRuntime.base.pipelineIO.baseHiddenStates, 2, mBlockDraft.baseOutputHiddenDim, stream);
+    dflashDebugStats<float>("draftLogits", mDraftOutputLogits, bs, mBlockDraft.draftVocabSize, stream);
+    std::vector<int32_t> ids(static_cast<size_t>(bs));
+    cudaMemcpy(ids.data(), mHostDraftInputIds.rawPointer(), ids.size() * sizeof(int32_t), cudaMemcpyHostToHost);
+    std::string s;
+    for (auto id : ids) { s += std::to_string(id) + " "; }
+    LOG_INFO("[dflash-debug] draft input ids: %s", s.c_str());
