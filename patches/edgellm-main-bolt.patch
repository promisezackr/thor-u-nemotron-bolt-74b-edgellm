@@ -0,0 +1,215 @@
+# SPDX-License-Identifier: Apache-2.0
+"""LiLiCorr correlation head (arXiv 2608.20530) as a torch module exportable inside the draft graph.
+
+Semantics follow the llama.cpp reference (src/models/dflash.cpp::build_lilicorr_scores):
+
+* per drafted slot s = 1..block-1 take the top-k draft candidates (sorted by logit),
+* build node states: token_proj(embed[cand]) + pass_hidden_proj(draft hidden of the slot)
+  + feature_mlp(LayerNorm([log p, p, log p - log p_top, rank/(k-1), rank==0])) + slot/rank embeddings,
+* run two small transformer layers over the (block-1)*k nodes with a per-head additive bias that depends on
+  the slot distance (relative_slot_bias) and a same-slot term,
+* factor = silu(factor_input_proj([x, anchor, x*anchor])); in = l2norm(in_head(factor)); out = l2norm(out_head(factor)),
+* scores: slot 1 vs anchor_out (anchor = context_proj(fused target hidden of the anchor token)),
+  slot s vs out of slot s-1, scaled by logit_scale.
+
+Outputs ``candidates`` [B, slots, k] int32 and ``scores`` [B, slots, k, k] fp32 (slot 0 valid only in column
+block [:, 0, 0, :]); the runtime walks the lattice greedily: pred=0; for s: pred = argmax(scores[s, pred]).
+"""
+import os
+from typing import Tuple
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class _RMSNorm(nn.Module):
+
+    def __init__(self, size: int, eps: float) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(size, dtype=torch.float16), requires_grad=False)
+        self.eps = eps
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = x.to(torch.float32)
+        x = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + self.eps)
+        return x * self.weight.to(torch.float32)
+
+
+class _Linear(nn.Module):
+    """FP16 weights, FP32 compute (the head is tiny: at most 56 rows)."""
+
+    def __init__(self, in_f: int, out_f: int, bias: bool = True) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(torch.zeros(out_f, in_f, dtype=torch.float16), requires_grad=False)
+        self.bias = nn.Parameter(torch.zeros(out_f, dtype=torch.float16), requires_grad=False) if bias else None
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        b = self.bias.to(torch.float32) if self.bias is not None else None
+        return F.linear(x.to(torch.float32), self.weight.to(torch.float32), b)
+
+
+class _HeadLayer(nn.Module):
+
+    def __init__(self, hidden: int, mlp_hidden: int, eps: float) -> None:
+        super().__init__()
+        self.attn_norm = _RMSNorm(hidden, eps)
+        self.attn = nn.Module()
+        self.attn.in_proj = _Linear(hidden, 3 * hidden)
+        self.attn.out_proj = _Linear(hidden, hidden)
+        self.mlp_norm = _RMSNorm(hidden, eps)
+        self.mlp = nn.Module()
+        self.mlp.up_proj = _Linear(hidden, mlp_hidden)
+        self.mlp.down_proj = _Linear(mlp_hidden, hidden)
+
+
+class LiLiCorrHead(nn.Module):
+    """Checkpoint keys live under ``lilicorr.*`` (loaded with prefix ``lilicorr``)."""
+
+    def __init__(self, hidden_size: int, lili_hidden: int, top_k: int, num_heads: int, num_layers: int,
+                 factor_dim: int, block_size: int, mlp_ratio: float, vector_eps: float, logit_scale: float,
+                 rms_eps: float = 1e-6, ckpt_block_size: int = None) -> None:
+        super().__init__()
+        # block_size = runtime proposal block this head instance serves (slots = block_size - 1);
+        # ckpt_block_size = block the checkpoint tables were trained with (sizes slot/bias tables).
+        self.top_k, self.heads, self.block = top_k, num_heads, block_size
+        self.ckpt_block = int(ckpt_block_size or block_size)
+        assert 2 <= block_size <= self.ckpt_block, "head block must be in [2, checkpoint block]"
+        self.slots = block_size - 1
+        ckpt_slots = self.ckpt_block - 1
+        self.hidden = lili_hidden
+        self.head_dim = lili_hidden // num_heads
+        self.vector_eps, self.logit_scale = vector_eps, logit_scale
+        mlp_hidden = int(lili_hidden * mlp_ratio)
+        self.token_proj = _Linear(hidden_size, lili_hidden)
+        self.context_proj = _Linear(hidden_size, lili_hidden)
+        self.pass_hidden_proj = _Linear(hidden_size, lili_hidden)
+        self.feature_norm = nn.Module()
+        self.feature_norm.weight = nn.Parameter(torch.ones(5, dtype=torch.float16), requires_grad=False)
+        self.feature_norm.bias = nn.Parameter(torch.zeros(5, dtype=torch.float16), requires_grad=False)
+        self.feature_mlp = nn.Module()
+        self.feature_mlp.up_proj = _Linear(5, lili_hidden)
+        self.feature_mlp.down_proj = _Linear(lili_hidden, lili_hidden)
+        # checkpoint shapes: slot_embedding [1,1,slots,1,H], rank_embedding [1,1,1,k,H]
+        self.slot_embedding = nn.Parameter(torch.zeros(1, 1, ckpt_slots, 1, lili_hidden, dtype=torch.float16),
+                                           requires_grad=False)
+        self.rank_embedding = nn.Parameter(torch.zeros(1, 1, 1, top_k, lili_hidden, dtype=torch.float16),
+                                           requires_grad=False)
+        self.relative_slot_bias = nn.Parameter(torch.zeros(num_heads, 2 * self.ckpt_block - 1, dtype=torch.float16),
+                                               requires_grad=False)
+        self.same_slot_bias = nn.Parameter(torch.zeros(num_heads, dtype=torch.float16), requires_grad=False)
+        self.layers = nn.ModuleList([_HeadLayer(lili_hidden, mlp_hidden, rms_eps) for _ in range(num_layers)])
+        self.output_norm = _RMSNorm(lili_hidden, rms_eps)
+        self.anchor_norm = _RMSNorm(lili_hidden, rms_eps)
+        self.factor_input_proj = _Linear(3 * lili_hidden, lili_hidden)
+        self.in_head = _Linear(lili_hidden, factor_dim)
+        self.out_head = _Linear(lili_hidden, factor_dim)
+        self.anchor_out_head = _Linear(lili_hidden, factor_dim)
+
+    # -- helpers ---------------------------------------------------------------------------------------------
+    def attention_bias(self) -> torch.Tensor:
+        """[heads, nodes, nodes]: relative_slot_bias[h, q_slot - k_slot + block - 1] (+ same_slot_bias on the diagonal slot)."""
+        k = self.top_k
+        slot_of_node = torch.arange(self.slots * k, device=self.relative_slot_bias.device) // k
+        diff = slot_of_node[:, None] - slot_of_node[None, :] + (self.ckpt_block - 1)  # [nodes, nodes]
+        rel = self.relative_slot_bias.to(torch.float32)[:, diff]  # [heads, nodes, nodes]
+        same = (slot_of_node[:, None] == slot_of_node[None, :]).to(torch.float32)
+        return rel + self.same_slot_bias.to(torch.float32)[:, None, None] * same[None]
+
+    def _l2norm(self, x: torch.Tensor) -> torch.Tensor:
+        return x / torch.sqrt((x * x).sum(-1, keepdim=True) + self.vector_eps)
+
+    # -- forward ---------------------------------------------------------------------------------------------
+    def forward(self, logits: torch.Tensor, draft_hidden: torch.Tensor, anchor_g: torch.Tensor,
+                embed_table: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+        """logits [B, block, V] fp32; draft_hidden [B, block, H] (final-norm output); anchor_g [B, H];
+        embed_table [V, H] fp16.  Returns candidates [B, slots, k] int32, scores [B, slots, k, k] fp32."""
+        B = logits.shape[0]
+        k, slots = self.top_k, self.slots
+        slot_logits = logits[:, 1:, :].to(torch.float32)  # [B, slots, V]
+        cand_logits, candidates = torch.topk(slot_logits, k, dim=-1)  # sorted descending
+        if os.environ.get("LILICORR_HEAD_PROBS", "lse") == "softmax":
+            probs = torch.softmax(slot_logits, dim=-1).gather(-1, candidates)  # [B, slots, k]
+            lp = torch.log(probs)
+            relative = lp - lp[..., :1]
+        else:
+            # log p directly from the top-k values: lp = logit - logsumexp(all logits); no softmax-over-V,
+            # no GatherElements, no Slice (top-1 is the row max since topk is sorted).
+            lse = torch.logsumexp(slot_logits, dim=-1, keepdim=True)  # [B, slots, 1]
+            lp = cand_logits - lse
+            probs = torch.exp(lp)
+            relative = lp - torch.amax(lp, dim=-1, keepdim=True)
+        # Feature block without CumSum / Expand / Where / Concat: TensorRT's Myelin backend faulted (illegal
+        # address) on the Expand-from-runtime-Shape + Where pattern, so the 5 features stay separate tensors
+        # and the LayerNorm + first MLP layer are expanded per feature with broadcast arithmetic.
+        rank_const = (torch.arange(k, device=lp.device, dtype=torch.float32) / float(k - 1 if k > 1 else 1))
+        first_const = (torch.arange(k, device=lp.device) == 0).to(torch.float32)
+        zero_b = lp * 0.0
+        feats = [lp, probs.to(torch.float32), relative, zero_b + rank_const, zero_b + first_const]  # 5 x [B,slots,k]
+        mu = (feats[0] + feats[1] + feats[2] + feats[3] + feats[4]) * 0.2
+        devs = [f - mu for f in feats]
+        var = (devs[0] * devs[0] + devs[1] * devs[1] + devs[2] * devs[2] + devs[3] * devs[3] + devs[4] * devs[4]) * 0.2
+        inv = torch.rsqrt(var + 1e-5)
+        ln_w = self.feature_norm.weight.to(torch.float32)
+        ln_b = self.feature_norm.bias.to(torch.float32)
+        w_up = self.feature_mlp.up_proj.weight.to(torch.float32)  # [H, 5]
+        up = self.feature_mlp.up_proj.bias.to(torch.float32)  # [H]
+        for i in range(5):
+            n_i = (devs[i] * inv) * ln_w[i] + ln_b[i]  # normalised feature i, [B,slots,k]
+            up = up + n_i.unsqueeze(-1) * w_up[:, i]  # broadcast outer product -> [B,slots,k,H]
+        feature_states = self.feature_mlp.down_proj(F.silu(up))
+
+        # int32 indices + index_select (plain ONNX Gather): TensorRT handles these natively; the int64
+        # GatherND emitted for advanced indexing is what we suspect behind an illegal-address fault.
+        dbg = os.environ.get("LILICORR_HEAD_DEBUG", "")
+        cand32 = candidates.to(torch.int32)
+        embeds = embed_table.index_select(0, cand32.reshape(-1)).reshape(B, slots, k, -1).to(torch.float32)
+        if dbg == "zero_embed":
+            embeds = torch.zeros_like(embeds)
+        token_states = self.token_proj(embeds)
+        pass_states = self.pass_hidden_proj(draft_hidden[:, 1:, :].to(torch.float32))[:, :, None, :]
+        pos = (self.slot_embedding.to(torch.float32)[0, 0, :slots]
+               + self.rank_embedding.to(torch.float32)[0, 0])  # [slots,k,H] (first `slots` checkpoint slots)
+        x = token_states + pass_states + feature_states + pos[None]  # [B, slots, k, H]
+        x = x.reshape(B, slots * k, self.hidden)
+        if dbg == "zero_anchor":
+            anchor_g = torch.zeros_like(anchor_g)
+        anchor_state = self.context_proj(anchor_g.to(torch.float32))  # [B, H]
+
+        bias = self.attention_bias()[None]  # [1, heads, nodes, nodes]
+        scale = 1.0 / (self.head_dim ** 0.5)
+        for layer in self.layers:
+            h = layer.attn_norm(x)
+            qkv = layer.attn.in_proj(h)
+            q, kk, v = qkv.split(self.hidden, dim=-1)
+            q = q.reshape(B, -1, self.heads, self.head_dim).transpose(1, 2)
+            kk = kk.reshape(B, -1, self.heads, self.head_dim).transpose(1, 2)
+            v = v.reshape(B, -1, self.heads, self.head_dim).transpose(1, 2)
+            att = torch.softmax(torch.matmul(q, kk.transpose(-1, -2)) * scale + bias, dim=-1)
+            o = torch.matmul(att, v).transpose(1, 2).reshape(B, -1, self.hidden)
+            x = x + layer.attn.out_proj(o)
+            x = x + layer.mlp.down_proj(F.silu(layer.mlp.up_proj(layer.mlp_norm(x))))
+
+        x = self.output_norm(x)  # [B, nodes, H]
+        anchor_state = self.anchor_norm(anchor_state)  # [B, H]
+        # factor_input_proj([x, a, x*a]) == Wx.x + Wa.a + Wxa.(x*a) + b  (no Concat / Expand)
+        anchor_rep = anchor_state[:, None, :] + x * 0.0  # broadcast to [B, nodes, H]
+        w_f = self.factor_input_proj.weight.to(torch.float32)  # [H, 3H]
+        h3 = self.hidden
+        factors = (F.linear(x, w_f[:, :h3]) + F.linear(anchor_rep, w_f[:, h3:2 * h3])
+                   + F.linear(x * anchor_rep, w_f[:, 2 * h3:]) + self.factor_input_proj.bias.to(torch.float32))
+        factors = F.silu(factors)
+        out_v = self._l2norm(self.out_head(factors)).reshape(B, slots, k, -1)
+        in_v = self._l2norm(self.in_head(factors)).reshape(B, slots, k, -1)
+        anchor_out = self._l2norm(self.anchor_out_head(anchor_state))  # [B, F]
+
+        first_score = torch.einsum("bkf,bf->bk", in_v[:, 0], anchor_out) * self.logit_scale  # [B, k]
+        ones_k1 = torch.ones(k, 1, dtype=torch.float32, device=logits.device)
+        first_block = first_score[:, None, :] * ones_k1  # [B, k, k]: every predecessor row -> same scores
+        if slots > 1:
+            # scores[b, s, p, c] = out[s-1, p] . in[s, c]
+            rest = torch.einsum("bspf,bscf->bspc", out_v[:, :-1], in_v[:, 1:]) * self.logit_scale
+            scores = torch.cat([first_block[:, None], rest], dim=1)
+        else:
+            scores = first_block[:, None]
+        return cand32, scores
